-- ══════════════════════════════════════════════════════
--  TWEEN HELPERS
-- ══════════════════════════════════════════════════════
local function tw(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

local T_OUT    = TweenInfo.new(0.40, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local T_IN     = TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
local T_SPRING = TweenInfo.new(0.55, Enum.EasingStyle.Back,  Enum.EasingDirection.Out)
local function T_LIN(t) return TweenInfo.new(t, Enum.EasingStyle.Linear) end

-- ══════════════════════════════════════════════════════
--  STACK
-- ══════════════════════════════════════════════════════
local active = {}

local function reflow()
    local slot = 0
    for i = #active, 1, -1 do
        local e = active[i]
        if not e.dismissed then
            local yOff = isBottom
                and -(CFG.EdgePad + slot * (e.cardH + CFG.Gap) + e.cardH)
                or   CFG.EdgePad + slot * (e.cardH + CFG.Gap)
            tw(e.frame, T_OUT, {
                Position = UDim2.new(0, 0, isBottom and 1 or 0, yOff)
            })
            slot += 1
        end
    end
end

local function dismiss(entry)
    if entry.dismissed then return end
    entry.dismissed = true

    -- Cancel timers
    if entry.autoThread  then task.cancel(entry.autoThread)  end
    if entry.countThread then task.cancel(entry.countThread) end

    local offX   = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
    local curPos = entry.frame.Position

    tw(entry.frame, T_IN, {
        Position = UDim2.new(curPos.X.Scale, offX, curPos.Y.Scale, curPos.Y.Offset),
        BackgroundTransparency = 1,
    })

    for _, d in ipairs(entry.frame:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            tw(d, T_IN, { TextTransparency = 1 })
        elseif d:IsA("ImageLabel") then
            tw(d, T_IN, { ImageTransparency = 1, BackgroundTransparency = 1 })
        elseif d:IsA("Frame") then
            tw(d, T_IN, { BackgroundTransparency = 1 })
        end
    end

    task.delay(0.22, function()
        entry.frame:Destroy()
        for i = #active, 1, -1 do
            if active[i] == entry then table.remove(active, i) break end
        end
        reflow()
    end)
end

-- ══════════════════════════════════════════════════════
--  IMAGE ID RESOLVER
-- ══════════════════════════════════════════════════════
local function resolveImage(raw)
    if not raw or raw == "" then return nil end
    raw = tostring(raw):match("^%s*(.-)%s*$")
    if raw == "" then return nil end
    if raw:lower():find("^rbxassetid://") then return raw end
    if raw:match("^%d+$") then return "rbxassetid://" .. raw end
    if raw:lower():find("^https?://") then return raw end
    return raw
end

-- ══════════════════════════════════════════════════════
--  BUILD CARD
-- ══════════════════════════════════════════════════════
local function buildCard(title, description, notifType, imageId)
    local S      = STYLES[notifType] or STYLES.info
    local hasImg = imageId ~= nil
    local cardH  = hasImg and CFG.ImgHeight or CFG.MinHeight
    local leftX  = hasImg and (CFG.ImgSize + 16) or 46

    -- ── Frame ──────────────────────────────────────────────────
    local card = Instance.new("Frame")
    card.Name                   = "NotifCard"
    card.Size                   = UDim2.new(0, CFG.Width, 0, cardH)
    card.BackgroundColor3       = Color3.fromRGB(14, 16, 22)
    card.BackgroundTransparency = 0
    card.BorderSizePixel        = 0
    card.ClipsDescendants       = false
    card.ZIndex                 = 100
    card.Parent                 = Container

    -- Start off screen
    local offX = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
    card.Position = UDim2.new(
        0, offX,
        isBottom and 1 or 0,
        isBottom and -(CFG.EdgePad + cardH) or CFG.EdgePad
    )

    Instance.new("UICorner", card).CornerRadius = UDim.new(0, CFG.Corner)

    -- Border
    local stroke = Instance.new("UIStroke")
    stroke.Color           = Color3.fromRGB(42, 46, 62)
    stroke.Thickness       = 1
    stroke.Transparency    = 0.15
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent          = card

    -- Left accent strip
    local strip = Instance.new("Frame")
    strip.Size             = UDim2.new(0, 3, 1, -18)
    strip.Position         = UDim2.new(0, 0, 0, 9)
    strip.BackgroundColor3 = S.accent
    strip.BackgroundTransparency = 0
    strip.BorderSizePixel  = 0
    strip.ZIndex           = 101
    strip.Parent           = card
    Instance.new("UICorner", strip).CornerRadius = UDim.new(0, 3)

    -- ── Image OR Icon ───────────────────────────────────────────
    if hasImg then
        local imgFrame = Instance.new("Frame")
        imgFrame.Size             = UDim2.new(0, CFG.ImgSize, 0, CFG.ImgSize)
        imgFrame.Position         = UDim2.new(0, 7, 0.5, -CFG.ImgSize / 2)
        imgFrame.BackgroundColor3 = Color3.fromRGB(26, 28, 40)
        imgFrame.BackgroundTransparency = 0
        imgFrame.BorderSizePixel  = 0
        imgFrame.ZIndex           = 101
        imgFrame.Parent           = card
        Instance.new("UICorner", imgFrame).CornerRadius = UDim.new(0, 8)

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Size                   = UDim2.new(1, 0, 1, 0)
        imgLabel.BackgroundTransparency = 1
        imgLabel.Image                  = imageId
        imgLabel.ScaleType              = Enum.ScaleType.Crop
        imgLabel.ImageTransparency      = 0
        imgLabel.ZIndex                 = 102
        imgLabel.Parent                 = imgFrame
        Instance.new("UICorner", imgLabel).CornerRadius = UDim.new(0, 8)
    else
        local iconFrame = Instance.new("Frame")
        iconFrame.Size             = UDim2.new(0, 28, 0, 28)
        iconFrame.Position         = UDim2.new(0, 9, 0, 11)
        iconFrame.BackgroundColor3 = S.iconBg
        iconFrame.BackgroundTransparency = 0
        iconFrame.BorderSizePixel  = 0
        iconFrame.ZIndex           = 101
        iconFrame.Parent           = card
        Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(0, 7)

        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size                  = UDim2.new(1, 0, 1, 0)
        iconLbl.BackgroundTransparency= 1
        iconLbl.Text                  = S.icon
        iconLbl.TextColor3            = S.accent
        iconLbl.TextTransparency      = 0
        iconLbl.Font                  = Enum.Font.GothamBold
        iconLbl.TextSize              = 13
        iconLbl.ZIndex                = 102
        iconLbl.Parent                = iconFrame
    end

    -- ── Badge label (top-left) ──────────────────────────────────
    -- Mode 1: badge shrinks width to leave room for countdown on right
    -- Mode 2: badge uses full width
    local badgeW = (CFG.TimerMode == 1)
        and (CFG.Width - leftX - 52)   -- leave 48px for countdown
        or  (CFG.Width - leftX - 26)

    local badge = Instance.new("TextLabel")
    badge.Name                  = "Badge"
    badge.Size                  = UDim2.new(0, badgeW, 0, 14)
    badge.Position              = UDim2.new(0, leftX, 0, 8)
    badge.BackgroundTransparency= 1
    badge.Text                  = S.label
    badge.TextColor3            = S.accent
    badge.TextTransparency      = 0
    badge.Font                  = Enum.Font.GothamBold
    badge.TextSize              = 9
    badge.TextXAlignment        = Enum.TextXAlignment.Left
    badge.ZIndex                = 101
    badge.Parent                = card

    -- ── Mode 1: Countdown number (bottom-right) ─────────────────
    local countdownLbl = nil
    if CFG.TimerMode == 1 then
        countdownLbl = Instance.new("TextLabel")
        countdownLbl.Name                  = "Countdown"
        countdownLbl.Size                  = UDim2.new(0, 40, 0, 14)
        -- bottom-right corner, just above the very bottom edge
        countdownLbl.Position              = UDim2.new(1, -44, 1, -18)
        countdownLbl.BackgroundTransparency= 1
        countdownLbl.Text                  = "5s"   -- updated by timer loop
        -- Dark gray: 80% black, 20% gray, still readable
        countdownLbl.TextColor3            = Color3.fromRGB(58, 58, 68)
        countdownLbl.TextTransparency      = 0
        countdownLbl.Font                  = Enum.Font.GothamBold
        countdownLbl.TextSize              = 11
        countdownLbl.TextXAlignment        = Enum.TextXAlignment.Right
        countdownLbl.ZIndex                = 103
        countdownLbl.Parent                = card
    end

    -- ── Mode 2: Progress bar (bottom edge) ─────────────────────
    local barFill = nil
    if CFG.TimerMode == 2 then
        local barBg = Instance.new("Frame")
        barBg.Name             = "BarBg"
        barBg.Size             = UDim2.new(1, 0, 0, 3)
        barBg.Position         = UDim2.new(0, 0, 1, -3)
        barBg.BackgroundColor3 = Color3.fromRGB(20, 22, 34)
        barBg.BackgroundTransparency = 0
        barBg.BorderSizePixel  = 0
        barBg.ClipsDescendants = true
        barBg.ZIndex           = 101
        barBg.Parent           = card

        barFill = Instance.new("Frame")
        barFill.Name             = "BarFill"
        barFill.Size             = UDim2.new(1, 0, 1, 0)
        barFill.BackgroundColor3 = S.accent
        barFill.BackgroundTransparency = 0
        barFill.BorderSizePixel  = 0
        barFill.ZIndex           = 102
        barFill.Parent           = barBg
        Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 2)
    end

    -- ── Title ───────────────────────────────────────────────────
    local textY = 22
    if title ~= "" then
        local titleLbl = Instance.new("TextLabel")
        titleLbl.Name                  = "Title"
        titleLbl.Size                  = UDim2.new(0, CFG.Width - leftX - 26, 0, 17)
        titleLbl.Position              = UDim2.new(0, leftX, 0, textY)
        titleLbl.BackgroundTransparency= 1
        titleLbl.Text                  = title
        titleLbl.TextColor3            = Color3.fromRGB(226, 228, 244)
        titleLbl.TextTransparency      = 0
        titleLbl.Font                  = Enum.Font.GothamBold
        titleLbl.TextSize              = 13
        titleLbl.TextTruncate          = Enum.TextTruncate.AtEnd
        titleLbl.TextXAlignment        = Enum.TextXAlignment.Left
        titleLbl.ZIndex                = 101
        titleLbl.Parent                = card
        textY += 17
    end

    -- ── Description ─────────────────────────────────────────────
    local bottomPad = (CFG.TimerMode == 1) and 18 or 12
    if description ~= "" then
        local descLbl = Instance.new("TextLabel")
        descLbl.Name                  = "Description"
        descLbl.Size                  = UDim2.new(0, CFG.Width - leftX - 26, 0, cardH - textY - bottomPad)
        descLbl.Position              = UDim2.new(0, leftX, 0, textY)
        descLbl.BackgroundTransparency= 1
        descLbl.Text                  = description
        descLbl.TextColor3            = Color3.fromRGB(165, 168, 192)
        descLbl.TextTransparency      = 0
        descLbl.Font                  = Enum.Font.Gotham
        descLbl.TextSize              = 11
        descLbl.TextWrapped           = true
        descLbl.TextXAlignment        = Enum.TextXAlignment.Left
        descLbl.TextYAlignment        = Enum.TextYAlignment.Top
        descLbl.ZIndex                = 101
        descLbl.Parent                = card
    end

    -- ── Close button ────────────────────────────────────────────
    local closeBtn = Instance.new("TextButton")
    closeBtn.Name                  = "Close"
    closeBtn.Size                  = UDim2.new(0, 18, 0, 18)
    closeBtn.Position              = UDim2.new(1, -22, 0, 5)
    closeBtn.BackgroundTransparency= 1
    closeBtn.Text                  = "✕"
    closeBtn.TextColor3            = Color3.fromRGB(60, 64, 86)
    closeBtn.TextTransparency      = 0
    closeBtn.Font                  = Enum.Font.GothamBold
    closeBtn.TextSize              = 10
    closeBtn.ZIndex                = 103
    closeBtn.Parent                = card

    -- ── Shimmer flash on appear ─────────────────────────────────
    local shimmer = Instance.new("Frame")
    shimmer.Name             = "Shimmer"
    shimmer.Size             = UDim2.new(0.45, 0, 1, 0)
    shimmer.Position         = UDim2.new(-0.45, 0, 0, 0)
    shimmer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shimmer.BackgroundTransparency = 0.87
    shimmer.BorderSizePixel  = 0
    shimmer.ZIndex           = 104
    shimmer.Parent           = card
    Instance.new("UICorner", shimmer).CornerRadius = UDim.new(0, CFG.Corner)

    return {
        card         = card,
        barFill      = barFill,
        countdownLbl = countdownLbl,
        shimmer      = shimmer,
        stroke       = stroke,
        closeBtn     = closeBtn,
        cardH        = cardH,
        style        = S,
    }
end

-- ══════════════════════════════════════════════════════
--  NOTIFY  (main function)
-- ══════════════════════════════════════════════════════
local function NotifyInternal(arg1, arg2, arg3)

    -- ── Parse arguments ──────────────────────────────────────────
    local title, description, notifType, imageId, duration

    if type(arg1) == "table" then
        title       = tostring(arg1.Title       or "")
        description = tostring(arg1.Description or "")
        notifType   = tostring(arg1.Type        or "info"):lower()
        duration    = tonumber(arg1.Time)        or CFG.DefaultTime
        imageId     = resolveImage(arg1.Image)
    else
        -- legacy: Notify("msg", "type", seconds)
        title       = ""
        description = tostring(arg1 or "")
        notifType   = tostring(arg2 or "info"):lower()
        duration    = tonumber(arg3) or CFG.DefaultTime
        imageId     = nil
    end

    -- Validation
    if not STYLES[notifType] then notifType = "info" end
    duration = math.clamp(duration, 1, 60)

    -- Cull oldest if full
    if #active >= CFG.MaxVisible then
        dismiss(active[1])
        task.wait()
    end

    -- ── Build card ───────────────────────────────────────────────
    local parts = buildCard(title, description, notifType, imageId)
    local card         = parts.card
    local barFill      = parts.barFill
    local countdownLbl = parts.countdownLbl
    local shimmer      = parts.shimmer
    local stroke       = parts.stroke
    local closeBtn     = parts.closeBtn
    local cardH        = parts.cardH
    local S            = parts.style

    -- ── Register entry ───────────────────────────────────────────
    local entry = {
        frame        = card,
        cardH        = cardH,
        dismissed    = false,
        autoThread   = nil,
        countThread  = nil,
    }
    table.insert(active, entry)
    reflow()

    -- ── Slide in (spring from side) ──────────────────────────────
    task.delay(0.03, function()
        local p    = card.Position
        local offX = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
        card.Position = UDim2.new(p.X.Scale, offX, p.Y.Scale, p.Y.Offset)
        tw(card, T_SPRING, { Position = UDim2.new(0, 0, p.Y.Scale, p.Y.Offset) })
    end)

    -- ── Shimmer sweep ────────────────────────────────────────────
    task.delay(0.15, function()
        tw(shimmer, TweenInfo.new(0.65, Enum.EasingStyle.Sine),
            { Position = UDim2.new(1.1, 0, 0, 0) })
    end)

    -- ── Timer Mode 1: countdown number ───────────────────────────
    if CFG.TimerMode == 1 and countdownLbl then
        local remaining = duration
        -- Update label every second
        entry.countThread = task.spawn(function()
            while remaining > 0 and not entry.dismissed do
                countdownLbl.Text = tostring(remaining) .. "s"
                -- Fade darker as time runs out (optional subtle effect)
                local pct = remaining / duration   -- 1.0 → 0.0
                -- stays dark gray, very slightly lighter at start
                local grayVal = math.floor(48 + pct * 18)  -- 66 → 48
                countdownLbl.TextColor3 = Color3.fromRGB(grayVal, grayVal, grayVal + 10)
                task.wait(1)
                remaining -= 1
            end
            if not entry.dismissed then
                countdownLbl.Text = "0s"
            end
        end)
    end

    -- ── Timer Mode 2: bar drain ───────────────────────────────────
    if CFG.TimerMode == 2 and barFill then
        tw(barFill, T_LIN(duration), { Size = UDim2.new(0, 0, 1, 0) })
    end

    -- ── Hover effects ────────────────────────────────────────────
    card.MouseEnter:Connect(function()
        tw(stroke, TweenInfo.new(0.15), { Color = S.accent, Transparency = 0.08 })
        tw(closeBtn, TweenInfo.new(0.15), { TextColor3 = Color3.fromRGB(205, 208, 228) })
    end)
    card.MouseLeave:Connect(function()
        tw(stroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(42, 46, 62), Transparency = 0.15 })
        tw(closeBtn, TweenInfo.new(0.15), { TextColor3 = Color3.fromRGB(60, 64, 86) })
    end)

    -- ── Close button ─────────────────────────────────────────────
    closeBtn.MouseButton1Click:Connect(function()
        dismiss(entry)
    end)

    -- ── Auto-dismiss after full duration ─────────────────────────
    entry.autoThread = task.delay(duration, function()
        dismiss(entry)
    end)
end

-- ══════════════════════════════════════════════════════
--  EXPOSE GLOBALLY
--  _G.Notify       → standard Roblox scripts
--  getgenv().Notify → executor environments
-- ══════════════════════════════════════════════════════
_G.Notify = NotifyInternal

-- getgenv() only exists in executors, pcall to be safe
pcall(function()
    getgenv().Notify = NotifyInternal
end)
