-- LEVIATHAN HUB: MASTER MULTI-GAME LOADER
-- ══════════════════════════════════════════

local CURRENT_VERSION = "0.0.1"
local GAME_CONFIGS = {
    [4104106043] = "https://raw.githubusercontent.com/PuriumHuB/Purium/refs/heads/main/Tester.lua",
    -- Add more games here: [PlaceId] = "URL_TO_SOURCE_CODE"
}

local function boot()
    local gameUrl = GAME_CONFIGS[game.PlaceId]

    -- 1. Game Support Check
    if not gameUrl then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Leviathan Hub",
            Text = "This game is not supported!",
            Duration = 5
        })
        task.wait(2)
        script:Destroy()
        return
    end

    -- 2. Fetch Source Code
    local success, fullScript = pcall(function()
        return game:HttpGet(gameUrl)
    end)

    if not success then
        warn("[Leviathan]: Failed to connect to GitHub source.")
        return
    end

    -- 3. Parse Version from Source Code
    -- Looks for: -- VERSION:0.0.1
    local remoteVersion = string.match(fullScript, "%-%- VERSION:(%S+)")
    
    if remoteVersion then
        remoteVersion = string.gsub(remoteVersion, "%s+", "") -- Remove extra spaces
        if remoteVersion ~= CURRENT_VERSION then
            print("[Leviathan]: A new update (" .. remoteVersion .. ") is available!")
        end
    end

    -- 4. Execute Source Code
    local runSuccess, runErr = pcall(function()
        return loadstring(fullScript)()
    end)

    if not runSuccess then
        warn("[Leviathan]: Execution Error: " .. tostring(runErr))
    end
end

boot()
