-- ═══════════════════════════════════════════════════════
--  SERVICES  — safe for both LocalScript and executor
-- ═══════════════════════════════════════════════════════
local TweenService = game:GetService("TweenService")
local Players      = game:GetService("Players")

-- Wait for LocalPlayer safely
local LocalPlayer
repeat
    LocalPlayer = Players.LocalPlayer
    if not LocalPlayer then task.wait() end
until LocalPlayer

-- Wait for PlayerGui safely
local PlayerGui
repeat
    PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then task.wait() end
until PlayerGui

-- ═══════════════════════════════════════════════════════
--  CONFIG
-- ═══════════════════════════════════════════════════════
local CFG = {
    Position    = "TR",   -- TR | TL | BR | BL
    MaxVisible  = 5,
    DefaultTime = 5,      -- seconds
    Width       = 300,
    MinHeight   = 70,     -- height with no image
    ImgHeight   = 88,     -- height when image present
    ImgSize     = 52,
    Gap         = 8,
    EdgePad     = 18,
    Corner      = 10,
}

-- ═══════════════════════════════════════════════════════
--  TYPE STYLES
-- ═══════════════════════════════════════════════════════
local STYLES = {
    success = { accent = Color3.fromRGB(72, 214, 110), iconBg = Color3.fromRGB(18, 50, 30), icon = "✔" },
    info    = { accent = Color3.fromRGB(72, 214, 110), iconBg = Color3.fromRGB(18, 50, 30), icon = "●" },
    warning = { accent = Color3.fromRGB(238, 196, 36), iconBg = Color3.fromRGB(50, 42, 8),  icon = "▲" },
    error   = { accent = Color3.fromRGB(252, 76, 76),  iconBg = Color3.fromRGB(54, 12, 12), icon = "✖" },
}

-- ═══════════════════════════════════════════════════════
--  BUILD GUI
--  Destroy old instance first so re-injection is safe
-- ═══════════════════════════════════════════════════════
local GUI_NAME = "__LuaNotify_v4__"
local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then oldGui:Destroy() end

local Screen = Instance.new("ScreenGui")
Screen.Name            = GUI_NAME
Screen.ResetOnSpawn    = false
Screen.IgnoreGuiInset  = true
Screen.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
Screen.DisplayOrder    = 9999         -- renders on top of everything
Screen.Parent          = PlayerGui

-- Derive anchor flags from position string
local isLeft   = CFG.Position:sub(2, 2) == "L"
local isBottom = CFG.Position:sub(1, 1) == "B"

-- Container: full-height strip anchored to chosen edge
local Container = Instance.new("Frame")
Container.Name                   = "NotifContainer"
Container.BackgroundTransparency = 1
Container.BorderSizePixel        = 0
Container.Size                   = UDim2.new(0, CFG.Width, 1, 0)
Container.ClipsDescendants       = false
Container.Position               = isLeft
    and UDim2.new(0, CFG.EdgePad, 0, 0)
    or  UDim2.new(1, -(CFG.Width + CFG.EdgePad), 0, 0)
Container.Parent = Screen

-- ═══════════════════════════════════════════════════════
--  TWEEN HELPERS
-- ═══════════════════════════════════════════════════════
local function tw(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local T_OUT    = TweenInfo.new(0.40, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local T_IN     = TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
local T_SPRING = TweenInfo.new(0.55, Enum.EasingStyle.Back,  Enum.EasingDirection.Out)
local function T_LIN(t) return TweenInfo.new(t, Enum.EasingStyle.Linear) end

-- ═══════════════════════════════════════════════════════
--  STACK  (active notification entries)
-- ═══════════════════════════════════════════════════════
local active = {}   -- { frame, cardH, dismissed, thread }

-- Restack all visible cards
local function reflow()
    local slot = 0
    for i = #active, 1, -1 do
        local e = active[i]
        if not e.dismissed then
            local yOff = isBottom
                and -(CFG.EdgePad + slot * (e.cardH + CFG.Gap) + e.cardH)
                or   CFG.EdgePad + slot * (e.cardH + CFG.Gap)
            tw(e.frame, T_OUT, {
                Position = UDim2.new(0, 0, isBottom and 1 or 0, yOff)
            })
            slot += 1
        end
    end
end

-- Slide card out and destroy it
local function dismiss(entry)
    if entry.dismissed then return end
    entry.dismissed = true
    if entry.thread then task.cancel(entry.thread) end

    -- Slide off screen to the correct side
    local offX   = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
    local curPos = entry.frame.Position

    tw(entry.frame, T_IN, {
        Position = UDim2.new(
            curPos.X.Scale, offX,
            curPos.Y.Scale, curPos.Y.Offset
        ),
        BackgroundTransparency = 1,
    })

    -- Fade every child
    for _, d in ipairs(entry.frame:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            tw(d, T_IN, { TextTransparency = 1 })
        elseif d:IsA("ImageLabel") then
            tw(d, T_IN, { ImageTransparency = 1, BackgroundTransparency = 1 })
        elseif d:IsA("Frame") then
            tw(d, T_IN, { BackgroundTransparency = 1 })
        end
    end

    -- Remove after animation completes
    task.delay(0.22, function()
        entry.frame:Destroy()
        -- Remove from active list
        for i = #active, 1, -1 do
            if active[i] == entry then
                table.remove(active, i)
                break
            end
        end
        reflow()
    end)
end

-- ═══════════════════════════════════════════════════════
--  IMAGE ID RESOLVER
--  Accepts:  rbxassetid://123   123   http://...
-- ═══════════════════════════════════════════════════════
local function resolveImage(raw)
    if not raw or raw == "" then return nil end
    raw = tostring(raw):match("^%s*(.-)%s*$")   -- trim whitespace
    if raw == "" then return nil end

    -- Already a full rbxassetid
    if raw:lower():find("^rbxassetid://") then
        return raw
    end
    -- Plain number → wrap
    if raw:match("^%d+$") then
        return "rbxassetid://" .. raw
    end
    -- HTTP/HTTPS link (executor webimages)
    if raw:lower():find("^https?://") then
        return raw
    end
    -- Anything else try as-is
    return raw
end

-- ═══════════════════════════════════════════════════════
--  MAKE ONE CARD
-- ═══════════════════════════════════════════════════════
local function makeCard(title, description, notifType, imageId, duration)
    local S       = STYLES[notifType] or STYLES.info
    local hasImg  = imageId ~= nil
    local cardH   = hasImg and CFG.ImgHeight or CFG.MinHeight

    -- Left content offset: image takes more space than icon
    local leftEdge = hasImg and (CFG.ImgSize + 16) or 46

    -- ── Card frame ──────────────────────────────────────────────
    local card = Instance.new("Frame")
    card.Name                   = "NotifCard"
    card.Size                   = UDim2.new(0, CFG.Width, 0, cardH)
    card.BackgroundColor3       = Color3.fromRGB(16, 18, 24)
    card.BackgroundTransparency = 0           -- FULLY OPAQUE (was the bug)
    card.BorderSizePixel        = 0
    card.ClipsDescendants       = false
    card.ZIndex                 = 100
    card.Parent                 = Container

    -- Position off-screen so spring slides it in
    local offX = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
    card.Position = UDim2.new(
        0, offX,
        isBottom and 1 or 0,
        isBottom and -(CFG.EdgePad + cardH) or CFG.EdgePad
    )

    -- Rounded corners
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, CFG.Corner)
    corner.Parent = card

    -- Thin border
    local stroke = Instance.new("UIStroke")
    stroke.Color           = Color3.fromRGB(45, 48, 65)
    stroke.Thickness       = 1
    stroke.Transparency    = 0.2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent          = card

    -- ── Left accent strip ────────────────────────────────────────
    local strip = Instance.new("Frame")
    strip.Name             = "Strip"
    strip.Size             = UDim2.new(0, 3, 1, -18)
    strip.Position         = UDim2.new(0, 0, 0, 9)
    strip.BackgroundColor3 = S.accent
    strip.BackgroundTransparency = 0
    strip.BorderSizePixel  = 0
    strip.ZIndex           = 101
    strip.Parent           = card
    Instance.new("UICorner", strip).CornerRadius = UDim.new(0, 3)

    -- ── Image OR icon ────────────────────────────────────────────
    if hasImg then
        -- Image box
        local imgFrame = Instance.new("Frame")
        imgFrame.Name             = "ImgFrame"
        imgFrame.Size             = UDim2.new(0, CFG.ImgSize, 0, CFG.ImgSize)
        imgFrame.Position         = UDim2.new(0, 7, 0.5, -CFG.ImgSize / 2)
        imgFrame.BackgroundColor3 = Color3.fromRGB(28, 30, 42)
        imgFrame.BackgroundTransparency = 0
        imgFrame.BorderSizePixel  = 0
        imgFrame.ZIndex           = 101
        imgFrame.Parent           = card
        Instance.new("UICorner", imgFrame).CornerRadius = UDim.new(0, 8)

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Name                   = "Img"
        imgLabel.Size                   = UDim2.new(1, 0, 1, 0)
        imgLabel.BackgroundTransparency = 1
        imgLabel.Image                  = imageId
        imgLabel.ScaleType              = Enum.ScaleType.Crop
        imgLabel.ImageTransparency      = 0
        imgLabel.ZIndex                 = 102
        imgLabel.Parent                 = imgFrame
        Instance.new("UICorner", imgLabel).CornerRadius = UDim.new(0, 8)
    else
        -- Icon box
        local iconFrame = Instance.new("Frame")
        iconFrame.Name             = "IconFrame"
        iconFrame.Size             = UDim2.new(0, 28, 0, 28)
        iconFrame.Position         = UDim2.new(0, 9, 0, 11)
        iconFrame.BackgroundColor3 = S.iconBg
        iconFrame.BackgroundTransparency = 0
        iconFrame.BorderSizePixel  = 0
        iconFrame.ZIndex           = 101
        iconFrame.Parent           = card
        Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(0, 7)

        local iconLbl = Instance.new("TextLabel")
        iconLbl.Name                  = "Icon"
        iconLbl.Size                  = UDim2.new(1, 0, 1, 0)
        iconLbl.BackgroundTransparency= 1
        iconLbl.Text                  = S.icon
        iconLbl.TextColor3            = S.accent
        iconLbl.TextTransparency      = 0
        iconLbl.Font                  = Enum.Font.GothamBold
        iconLbl.TextSize              = 13
        iconLbl.ZIndex                = 102
        iconLbl.Parent                = iconFrame
    end

    -- ── Type badge ───────────────────────────────────────────────
    local badge = Instance.new("TextLabel")
    badge.Name                  = "Badge"
    badge.Size                  = UDim2.new(0, CFG.Width - leftEdge - 28, 0, 14)
    badge.Position              = UDim2.new(0, leftEdge, 0, 8)
    badge.BackgroundTransparency= 1
    badge.Text                  = notifType:upper()
    badge.TextColor3            = S.accent
    badge.TextTransparency      = 0
    badge.Font                  = Enum.Font.GothamBold
    badge.TextSize              = 9
    badge.TextXAlignment        = Enum.TextXAlignment.Left
    badge.ZIndex                = 101
    badge.Parent                = card

    -- ── Title (if provided) ──────────────────────────────────────
    local textY = 22
    if title ~= "" then
        local titleLbl = Instance.new("TextLabel")
        titleLbl.Name                  = "Title"
        titleLbl.Size                  = UDim2.new(0, CFG.Width - leftEdge - 28, 0, 17)
        titleLbl.Position              = UDim2.new(0, leftEdge, 0, textY)
        titleLbl.BackgroundTransparency= 1
        titleLbl.Text                  = title
        titleLbl.TextColor3            = Color3.fromRGB(228, 230, 244)
        titleLbl.TextTransparency      = 0
        titleLbl.Font                  = Enum.Font.GothamBold
        titleLbl.TextSize              = 13
        titleLbl.TextTruncate          = Enum.TextTruncate.AtEnd
        titleLbl.TextXAlignment        = Enum.TextXAlignment.Left
        titleLbl.ZIndex                = 101
        titleLbl.Parent                = card
        textY = textY + 17
    end

    -- ── Description (if provided) ────────────────────────────────
    if description ~= "" then
        local descLbl = Instance.new("TextLabel")
        descLbl.Name                  = "Description"
        descLbl.Size                  = UDim2.new(0, CFG.Width - leftEdge - 28, 0, cardH - textY - 12)
        descLbl.Position              = UDim2.new(0, leftEdge, 0, textY)
        descLbl.BackgroundTransparency= 1
        descLbl.Text                  = description
        descLbl.TextColor3            = Color3.fromRGB(170, 174, 196)
        descLbl.TextTransparency      = 0
        descLbl.Font                  = Enum.Font.Gotham
        descLbl.TextSize              = 11
        descLbl.TextWrapped           = true
        descLbl.TextXAlignment        = Enum.TextXAlignment.Left
        descLbl.TextYAlignment        = Enum.TextYAlignment.Top
        descLbl.ZIndex                = 101
        descLbl.Parent                = card
    end

    -- ── Close button ─────────────────────────────────────────────
    local closeBtn = Instance.new("TextButton")
    closeBtn.Name                  = "Close"
    closeBtn.Size                  = UDim2.new(0, 18, 0, 18)
    closeBtn.Position              = UDim2.new(1, -22, 0, 5)
    closeBtn.BackgroundTransparency= 1
    closeBtn.Text                  = "✕"
    closeBtn.TextColor3            = Color3.fromRGB(65, 68, 90)
    closeBtn.TextTransparency      = 0
    closeBtn.Font                  = Enum.Font.GothamBold
    closeBtn.TextSize              = 10
    closeBtn.ZIndex                = 103
    closeBtn.Parent                = card

    -- ── Progress bar ─────────────────────────────────────────────
    local barBg = Instance.new("Frame")
    barBg.Name             = "BarBg"
    barBg.Size             = UDim2.new(1, 0, 0, 3)
    barBg.Position         = UDim2.new(0, 0, 1, -3)
    barBg.BackgroundColor3 = Color3.fromRGB(22, 24, 36)
    barBg.BackgroundTransparency = 0
    barBg.BorderSizePixel  = 0
    barBg.ClipsDescendants = true
    barBg.ZIndex           = 101
    barBg.Parent           = card

    local barFill = Instance.new("Frame")
    barFill.Name             = "BarFill"
    barFill.Size             = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = S.accent
    barFill.BackgroundTransparency = 0
    barFill.BorderSizePixel  = 0
    barFill.ZIndex           = 102
    barFill.Parent           = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 2)

    -- ── Shimmer flash ────────────────────────────────────────────
    local shimmer = Instance.new("Frame")
    shimmer.Name             = "Shimmer"
    shimmer.Size             = UDim2.new(0.45, 0, 1, 0)
    shimmer.Position         = UDim2.new(-0.45, 0, 0, 0)
    shimmer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shimmer.BackgroundTransparency = 0.88
    shimmer.BorderSizePixel  = 0
    shimmer.ZIndex           = 104
    shimmer.Parent           = card
    Instance.new("UICorner", shimmer).CornerRadius = UDim.new(0, CFG.Corner)

    return card, barFill, shimmer, stroke, closeBtn, cardH
end

-- ═══════════════════════════════════════════════════════
--  NOTIFY  — the main function
-- ═══════════════════════════════════════════════════════
function Notify(arg1, arg2, arg3)

    -- ── Parse args ───────────────────────────────────────────────
    local title, description, notifType, imageId, duration

    if type(arg1) == "table" then
        title       = tostring(arg1.Title       or "")
        description = tostring(arg1.Description or "")
        notifType   = tostring(arg1.Type        or "info"):lower()
        duration    = tonumber(arg1.Time)        or CFG.DefaultTime
        imageId     = resolveImage(arg1.Image)
    else
        title       = ""
        description = tostring(arg1 or "")
        notifType   = tostring(arg2 or "info"):lower()
        duration    = tonumber(arg3) or CFG.DefaultTime
        imageId     = nil
    end

    -- Sanitise
    if not STYLES[notifType] then notifType = "info" end
    duration = math.clamp(duration, 1, 60)

    -- Cull oldest if over limit
    if #active >= CFG.MaxVisible then
        dismiss(active[1])
        task.wait()     -- let dismiss register before adding new card
    end

    -- ── Build card ───────────────────────────────────────────────
    local card, barFill, shimmer, stroke, closeBtn, cardH =
        makeCard(title, description, notifType, imageId, duration)

    -- ── Register ─────────────────────────────────────────────────
    local entry = {
        frame     = card,
        cardH     = cardH,
        dismissed = false,
        thread    = nil,
    }
    table.insert(active, entry)

    -- Reflow so card gets its correct Y position
    reflow()

    -- ── Slide in (spring from side) ──────────────────────────────
    -- After reflow set Y, override X to off-screen then spring in
    task.delay(0.03, function()
        local p    = card.Position
        local offX = isLeft and -(CFG.Width + 60) or (CFG.Width + 60)
        card.Position = UDim2.new(p.X.Scale, offX, p.Y.Scale, p.Y.Offset)
        tw(card, T_SPRING, { Position = UDim2.new(0, 0, p.Y.Scale, p.Y.Offset) })
    end)

    -- Shimmer sweep after slide completes
    task.delay(0.15, function()
        tw(shimmer, TweenInfo.new(0.65, Enum.EasingStyle.Sine),
            { Position = UDim2.new(1.1, 0, 0, 0) })
    end)

    -- Progress bar drains over full duration
    tw(barFill, T_LIN(duration), { Size = UDim2.new(0, 0, 1, 0) })

    -- ── Hover ────────────────────────────────────────────────────
    local S = STYLES[notifType] or STYLES.info
    card.MouseEnter:Connect(function()
        tw(stroke, TweenInfo.new(0.15), { Color = S.accent, Transparency = 0.1 })
        tw(closeBtn, TweenInfo.new(0.15), { TextColor3 = Color3.fromRGB(210, 213, 235) })
    end)
    card.MouseLeave:Connect(function()
        tw(stroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(45, 48, 65), Transparency = 0.2 })
        tw(closeBtn, TweenInfo.new(0.15), { TextColor3 = Color3.fromRGB(65, 68, 90) })
    end)

    closeBtn.MouseButton1Click:Connect(function()
        dismiss(entry)
    end)

    -- ── Auto-dismiss after duration ──────────────────────────────
    entry.thread = task.delay(duration, function()
        dismiss(entry)
    end)
end

