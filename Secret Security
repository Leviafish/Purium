local starterGUI = game:GetService("StarterGui")
local player = game.Players.LocalPlayer

loadstring(game:HttpGet("https://scriptblox.com/raw/UPD-Blade-Ball-op-autoparry-with-visualizer-8652"))()

local RunService          = game:GetService("RunService") or game:FindFirstDescendant("RunService")
local Players             = game:GetService("Players")    or game:FindFirstDescendant("Players")
local VirtualInputManager = game:GetService("VirtualInputManager") or game:FindFirstDescendant("VirtualInputManager")

local Player = Players.LocalPlayer

-- ============================================================
--  STATE
-- ============================================================
local Parried      = false
local LastParry    = 0
local Connection   = nil

-- Tracker velocity để detect tăng tốc đột ngột
local PrevBallPos  = nil
local PrevBallTime = nil
local PrevSpeed    = 0

-- Anti-spam
local SpamLog = {}

-- ============================================================
--  CONFIG
-- ============================================================
local CFG = {
    -- ── 3 ZONE KHOẢNG CÁCH ─────────────────────────────────
    -- Zone Far:   bóng nhanh ở xa   → window rộng hơn vì cần predict sớm
    -- Zone Mid:   bóng nhanh ở tb   → window cân bằng
    -- Zone Close: bóng nhanh ở gần  → window nhỏ, react ngay
    ZoneFar   = 40,   -- studs, xa hơn đây = Far zone
    ZoneMid   = 18,   -- studs, xa hơn đây = Mid zone, gần hơn = Close zone

    WindowFar   = 0.55, 
    WindowMid   = 0.40, 
    WindowClose = 0.22, 

    Hitbox = 6,  

    AccelThreshold = 80,

    ParryCooldown   = 0.12,
    SpamCheckRadius = 20,
    SpamThreshold   = 3,
    SpamWindow      = 1.5,
    SpamCooldown    = 0.08,
}

local function Click()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true,  game, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function GetBall()
    for _, Ball in ipairs(workspace.Balls:GetChildren()) do
        if Ball:GetAttribute("realBall") then
            return Ball
        end
    end
end

local function ResetConnection()
    if Connection then
        Connection:Disconnect()
        Connection = nil
    end
end

workspace.Balls.ChildAdded:Connect(function()
    local Ball = GetBall()
    if not Ball then return end
    ResetConnection()
    PrevBallPos  = nil
    PrevBallTime = nil
    PrevSpeed    = 0
    Connection = Ball:GetAttributeChangedSignal("target"):Connect(function()
        Parried      = false
        PrevBallPos  = nil
        PrevBallTime = nil
        PrevSpeed    = 0
    end)
end)

local function RecordSpamEvent(name)
    if not SpamLog[name] then SpamLog[name] = {} end
    local log, now = SpamLog[name], tick()
    table.insert(log, now)
    local i = 1
    while i <= #log do
        if (now - log[i]) > CFG.SpamWindow then table.remove(log, i)
        else i += 1 end
    end
end

local function IsBeingSpammed()
    local char = Player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local now = tick()
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and other.Character then
            local oHRP = other.Character:FindFirstChild("HumanoidRootPart")
            if oHRP and (hrp.Position - oHRP.Position).Magnitude <= CFG.SpamCheckRadius then
                local log = SpamLog[other.Name]
                if log then
                    local count = 0
                    for _, t in ipairs(log) do
                        if (now - t) <= CFG.SpamWindow then count += 1 end
                    end
                    if count >= CFG.SpamThreshold then return true end
                end
            end
        end
    end
    return false
end

local function WatchPlayer(p)
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator")
        if not anim then return end
        anim.AnimationPlayed:Connect(function(track)
            local n = track.Name:lower()
            if n:find("swing") or n:find("block") or n:find("parry") or n:find("slash") then
                RecordSpamEvent(p.Name)
            end
        end)
    end
    if p.Character then task.spawn(onChar, p.Character) end
    p.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= Player then task.spawn(WatchPlayer, p) end
end
Players.PlayerAdded:Connect(function(p)
    SpamLog[p.Name] = nil
    if p ~= Player then WatchPlayer(p) end
end)
Players.PlayerRemoving:Connect(function(p) SpamLog[p.Name] = nil end)

task.spawn(function()
    while true do
        task.wait(30)
        local now = tick()
        for name, log in pairs(SpamLog) do
            local i = 1
            while i <= #log do
                if (now - log[i]) > CFG.SpamWindow * 4 then table.remove(log, i)
                else i += 1 end
            end
            if #log == 0 then SpamLog[name] = nil end
        end
    end
end)

RunService.PreSimulation:Connect(function()
    local char = Player.Character
    if not char then return end
    local HRP = char:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    local now = tick()

    if IsBeingSpammed() and (now - LastParry) >= CFG.SpamCooldown then
        Click()
        LastParry = now
        return
    end

    local Ball = GetBall()
    if not Ball or not HRP then return end
    if Ball:GetAttribute("target") ~= Player.Name then return end
    if Parried then return end
    if (now - LastParry) < CFG.ParryCooldown then return end

    local ballPos  = Ball.Position
    local hrpPos   = HRP.Position
    local vel      = Ball.zoomies.VectorVelocity
    local Speed    = vel.Magnitude
    local Distance = (hrpPos - ballPos).Magnitude

    local deltaVel, deltaSpd = nil, 0
    if PrevBallPos and PrevBallTime then
        local dt = now - PrevBallTime
        if dt > 0.0001 then
            deltaVel = (ballPos - PrevBallPos) / dt
            deltaSpd = deltaVel.Magnitude
        end
    end
    PrevBallPos  = ballPos
    PrevBallTime = now

    local accel = Speed - PrevSpeed
    PrevSpeed   = Speed

    local useVel, useSpd
    if Speed >= 3 and deltaVel and deltaSpd >= 3 then
        useVel = vel * 0.7 + deltaVel * 0.3
        useSpd = useVel.Magnitude
    elseif Speed >= 3 then
        useVel, useSpd = vel, Speed
    elseif deltaSpd >= 3 then
        useVel, useSpd = deltaVel, deltaSpd
    else
        return 
    end

    local toHRP       = hrpPos - ballPos
    local tClosest    = toHRP:Dot(useVel) / (useSpd * useSpd)
    local closestPos  = ballPos + useVel * math.max(tClosest, 0)
    local closestDist = (hrpPos - closestPos).Magnitude

    if closestDist > CFG.Hitbox then return end
    if tClosest < 0 then return end  
    local window
    if Distance > CFG.ZoneFar then
        window = CFG.WindowFar
    elseif Distance > CFG.ZoneMid then
        window = CFG.WindowMid
    else
        window = CFG.WindowClose
    end
    if accel > CFG.AccelThreshold then
        local accelScale = math.min(accel / CFG.AccelThreshold, 1.5)
        window = window * accelScale
    end
    if tClosest <= window then
        Click()
        Parried   = true
        LastParry = now
    end
end)
